<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lightui.com/2019">

    <Style x:Key="ContainerStyle" TargetType="{x:Type Border}">

        <Setter Property="Padding" Value="16" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style
        x:Key="ThemeButtonStyle"
        BasedOn="{StaticResource FramelessSystemButtonStyle}"
        TargetType="Button">
        <Setter Property="Content">
            <Setter.Value>
                <ui:FontIcon Glyph="&#xE708;" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static ui:ThemeManager.Current}, Path=CurrentTheme}" Value="Light">
                <Setter Property="Content">
                    <Setter.Value>
                        <ui:FontIcon Glyph="&#xE706;" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>