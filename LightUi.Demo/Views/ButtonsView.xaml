<UserControl
    x:Class="LightUi.Demo.Views.ButtonsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://caliburnmicro.com"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LightUi.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lightui.com/2019"
    d:DesignHeight="900"
    d:DesignWidth="600"
    mc:Ignorable="d">

    <ScrollViewer Padding="22" VerticalScrollBarVisibility="Auto">
        <ui:SimpleStackPanel Spacing="12">

            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Text="按钮类控件" />
            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Button / RepeatButton / ToggleButton / HyperlinkButton / DropDownButton" />

            <!--  Button  -->
            <Border
                Padding="16"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock FontWeight="SemiBold" Text="Button" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="普通按钮" />
                        <Button Content="Primary" Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="Disabled" IsEnabled="False" />
                        <Button>
                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="6">
                                <ui:FontIcon Glyph="&#xE710;" />
                                <TextBlock Text="带 FontIcon" />
                            </ui:SimpleStackPanel>
                        </Button>
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

            <!--  RepeatButton  -->
            <Border
                Padding="16"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock FontWeight="SemiBold" Text="RepeatButton（按住连续）" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                        <RepeatButton
                            xmlns:cal="clr-namespace:Caliburn.Micro;assembly=Caliburn.Micro.Platform"
                            cal:Message.Attach="Increase"
                            Content="+"
                            Delay="200"
                            FontSize="16"
                            Interval="80" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="18"
                            Text="{Binding Counter}" />
                        <RepeatButton
                            xmlns:cal="clr-namespace:Caliburn.Micro;assembly=Caliburn.Micro.Platform"
                            cal:Message.Attach="Decrease"
                            Content="−"
                            Delay="200"
                            FontSize="16"
                            Interval="80" />
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

            <!--  ToggleButton  -->
            <Border
                Padding="16"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock FontWeight="SemiBold" Text="ToggleButton（切换状态）" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                        <ToggleButton Content="未选中" />
                        <ToggleButton Content="已选中" IsChecked="True" />
                        <ToggleButton Content="Disabled" IsEnabled="False" />
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

            <!--  HyperlinkButton  -->
            <Border
                Padding="16"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock FontWeight="SemiBold" Text="HyperlinkButton（轻量跳转）" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                        <ui:HyperlinkButton Content="访问 GitHub" NavigateUri="https://github.com" />
                        <ui:HyperlinkButton Content="访问 NuGet" NavigateUri="https://www.nuget.org" />
                        <ui:HyperlinkButton Content="不跳转（纯样式）" />
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

            <!--  Button + Flyout（FlyoutService 附着属性）  -->
            <Border
                Padding="16"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock FontWeight="SemiBold" Text="Button + Flyout（ui:FlyoutService.Flyout）" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="普通按钮 挂 Flyout">
                            <ui:FlyoutService.Flyout>
                                <ui:Flyout Placement="Top" VerticalOffset="-4">
                                    <Border Padding="12">
                                        <ui:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                                            <Button Content="主题按钮" Style="{StaticResource AccentButtonStyle}" />
                                            <Button Content="普通按钮" />
                                        </ui:SimpleStackPanel>
                                    </Border>
                                </ui:Flyout>
                            </ui:FlyoutService.Flyout>
                        </Button>
                        <Button Content="普通 Button 也能挂 MenuFlyout">
                            <ui:FlyoutService.Flyout>
                                <ui:MenuFlyout VerticalOffset="6">
                                    <MenuItem Header="选项 1" />
                                    <MenuItem Header="选项 2" />
                                    <Separator />
                                    <MenuItem Header="更多…" />
                                </ui:MenuFlyout>
                            </ui:FlyoutService.Flyout>
                        </Button>
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

            <!--  DropDownButton  -->
            <Border
                Padding="16"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock FontWeight="SemiBold" Text="DropDownButton（点击弹出）" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                        <ui:DropDownButton Content="新建">
                            <ui:DropDownButton.Flyout>
                                <ui:MenuFlyout>
                                    <MenuItem x:Name="NewFile" cal:Message.Attach="NewFile">
                                        <MenuItem.Header>
                                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="10">
                                                <ui:FontIcon FontSize="14" Glyph="&#xE8A5;" />
                                                <TextBlock VerticalAlignment="Center" Text="新建文件" />
                                            </ui:SimpleStackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem>
                                        <MenuItem.Header>
                                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="10">
                                                <ui:FontIcon FontSize="14" Glyph="&#xE7C3;" />
                                                <TextBlock VerticalAlignment="Center" Text="新建项目" />
                                            </ui:SimpleStackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem>
                                        <MenuItem.Header>
                                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="10">
                                                <ui:FontIcon FontSize="14" Glyph="&#xE710;" />
                                                <TextBlock VerticalAlignment="Center" Text="从模板新建…" />
                                            </ui:SimpleStackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                </ui:MenuFlyout>
                            </ui:DropDownButton.Flyout>
                        </ui:DropDownButton>
                        <ui:DropDownButton Content="操作">
                            <ui:DropDownButton.Flyout>
                                <ui:MenuFlyout>
                                    <MenuItem>
                                        <MenuItem.Header>
                                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="10">
                                                <ui:FontIcon FontSize="14" Glyph="&#xE8C8;" />
                                                <TextBlock VerticalAlignment="Center" Text="复制" />
                                            </ui:SimpleStackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem>
                                        <MenuItem.Header>
                                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="10">
                                                <ui:FontIcon FontSize="14" Glyph="&#xE77F;" />
                                                <TextBlock VerticalAlignment="Center" Text="粘贴" />
                                            </ui:SimpleStackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem>
                                        <MenuItem.Header>
                                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="10">
                                                <ui:FontIcon FontSize="14" Glyph="&#xE74D;" />
                                                <TextBlock VerticalAlignment="Center" Text="删除" />
                                            </ui:SimpleStackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                </ui:MenuFlyout>
                            </ui:DropDownButton.Flyout>
                        </ui:DropDownButton>
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>


        </ui:SimpleStackPanel>
    </ScrollViewer>
</UserControl>
