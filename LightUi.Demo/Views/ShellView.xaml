<Window
    x:Class="LightUi.Demo.Views.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://caliburnmicro.com"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LightUi.Demo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lightui.com/2019"
    xmlns:views="clr-namespace:LightUi.Demo.Views"
    xmlns:vm="clr-namespace:LightUi.Demo.ViewModels"
    Title="ShellView"
    Width="1080"
    Height="720"
    d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
    ui:FramelessHelper.IsFrameless="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListBox
            Margin="6"
            Padding="0"
            Background="Transparent"
            BorderThickness="0"
            DisplayMemberPath="Title"
            DockPanel.Dock="Top"
            ItemsSource="{Binding NavItems, Mode=OneWay}"
            SelectedValue="{Binding ActiveItem}"
            SelectedValuePath="ViewModel"
            WindowChrome.IsHitTestVisibleInChrome="True" />

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ui:SimpleStackPanel
                Height="{Binding Path=(ui:FramelessHelper.CaptionHeight), Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}"
                Margin="0,0,138,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="ToggleTheme" Style="{StaticResource ThemeButtonStyle}" />
            </ui:SimpleStackPanel>

            <ContentControl x:Name="ActiveItem" Grid.Row="1" />
        </Grid>

    </Grid>

</Window>
