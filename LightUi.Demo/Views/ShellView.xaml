<Window
    x:Class="LightUi.Demo.Views.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://caliburnmicro.com"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LightUi.Demo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lightui.com/2019"
    xmlns:views="clr-namespace:LightUi.Demo.Views"
    xmlns:vm="clr-namespace:LightUi.Demo.ViewModels"
    Title="ShellView"
    Width="1080"
    Height="720"
    d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
    Style="{DynamicResource LightUiWindowStyle}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel LastChildFill="True">

            <ContentControl x:Name="ThemeViewModel" DockPanel.Dock="Bottom" />

            <ListBox
                DisplayMemberPath="Title"
                DockPanel.Dock="Top"
                ItemsSource="{Binding NavItems, Mode=OneWay}"
                SelectedValue="{Binding ActiveItem}"
                SelectedValuePath="ViewModel" />

        </DockPanel>

        <ContentControl x:Name="ActiveItem" Grid.Column="1" />

    </Grid>

</Window>
