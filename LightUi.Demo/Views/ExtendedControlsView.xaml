<UserControl
    x:Class="LightUi.Demo.Views.ExtendedControlsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LightUi.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lightui.com/2019"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <ScrollViewer Padding="22" VerticalScrollBarVisibility="Auto">

        <ui:SimpleStackPanel Spacing="12">

            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Text="扩展控件（ui:*）" />
            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="扩展控件：ToggleSwitch / FontIcon / SimpleStackPanel / HyperlinkButton / Flyout" />

            <Border Style="{StaticResource ContainerStyle}">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="ToggleSwitch" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="20">
                        <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <ui:ToggleSwitch
                                IsChecked="False"
                                OffContent="关闭"
                                OnContent="打开" />
                        </ui:SimpleStackPanel>
                        <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <ui:ToggleSwitch
                                IsChecked="True"
                                OffContent="关闭"
                                OnContent="打开" />
                        </ui:SimpleStackPanel>
                        <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <ui:ToggleSwitch
                                IsChecked="True"
                                IsEnabled="False"
                                OffContent="关闭"
                                OnContent="打开" />
                        </ui:SimpleStackPanel>
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

            <Border Style="{StaticResource ContainerStyle}">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="FontIcon（Segoe Fluent Icons）" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="16">
                        <ui:SimpleStackPanel Spacing="4">
                            <ui:FontIcon FontSize="18" Glyph="&#xE710;" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Add (E710)" />
                        </ui:SimpleStackPanel>
                        <ui:SimpleStackPanel Spacing="4">
                            <ui:FontIcon
                                FontSize="18"
                                Foreground="{DynamicResource AccentBrush}"
                                Glyph="&#xE74D;" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Delete (E74D)" />
                        </ui:SimpleStackPanel>
                        <ui:SimpleStackPanel Spacing="4">
                            <ui:FontIcon FontSize="18" Glyph="&#xE713;" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Settings (E713)" />
                        </ui:SimpleStackPanel>
                        <ui:SimpleStackPanel Spacing="4">
                            <ui:FontIcon
                                FontSize="18"
                                Foreground="{DynamicResource AccentBrush}"
                                Glyph="&#xE70D;" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Chevron Down (E70D)" />
                        </ui:SimpleStackPanel>
                        <ui:SimpleStackPanel Spacing="4">
                            <ui:FontIcon FontSize="18" Glyph="&#xE10A;" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Cancel (E10A)" />
                        </ui:SimpleStackPanel>
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

            <Border Style="{StaticResource ContainerStyle}">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="SimpleStackPanel（带 Spacing 的 Panel）" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="横向 Spacing=12" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Item1" Style="{DynamicResource AccentButtonStyle}" />
                        <Button Content="Item2" Style="{DynamicResource AccentButtonStyle}" />
                        <Button Content="Item3" Style="{DynamicResource AccentButtonStyle}" />
                        <Button Content="Item4" Style="{DynamicResource AccentButtonStyle}" />
                    </ui:SimpleStackPanel>

                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="纵向 Spacing=8" />
                    <ui:SimpleStackPanel Orientation="Vertical" Spacing="8">
                        <Button Content="Item1" Style="{DynamicResource AccentButtonStyle}" />
                        <Button Content="Item2" Style="{DynamicResource AccentButtonStyle}" />
                        <Button Content="Item3" Style="{DynamicResource AccentButtonStyle}" />

                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

            <Border Style="{StaticResource ContainerStyle}">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Flyout（依附弹出）" />
                    <ui:DropDownButton Content="点击我弹 Flyout">
                        <ui:DropDownButton.Flyout>
                            <ui:Flyout>
                                <ui:SimpleStackPanel Width="260" Spacing="8">
                                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Flyout 内容" />
                                    <TextBlock
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Text="Flyout 是依附控件的弹出层，可以承载任意 XAML 内容。"
                                        TextWrapping="Wrap" />
                                </ui:SimpleStackPanel>
                            </ui:Flyout>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>
                </ui:SimpleStackPanel>
            </Border>

            <Border Style="{StaticResource ContainerStyle}">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Button + Flyout" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="普通按钮 挂 Flyout">
                            <ui:FlyoutService.Flyout>
                                <ui:Flyout>
                                    <Border Padding="12">
                                        <ui:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                                            <Button Content="主题按钮" Style="{StaticResource AccentButtonStyle}" />
                                            <Button Content="普通按钮" />
                                        </ui:SimpleStackPanel>
                                    </Border>
                                </ui:Flyout>
                            </ui:FlyoutService.Flyout>
                        </Button>
                        <Button Content="普通 Button 挂 MenuFlyout">
                            <ui:FlyoutService.Flyout>
                                <ui:MenuFlyout>
                                    <MenuItem Header="选项 1" />
                                    <MenuItem Header="选项 2" />
                                    <Separator />
                                    <MenuItem Header="更多…" />
                                </ui:MenuFlyout>
                            </ui:FlyoutService.Flyout>
                        </Button>
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

        </ui:SimpleStackPanel>

    </ScrollViewer>

</UserControl>
