<UserControl
    x:Class="LightUi.Demo.Views.ExtendedControlsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LightUi.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lightui.com/2019"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <ScrollViewer Padding="22" VerticalScrollBarVisibility="Auto">

        <ui:SimpleStackPanel Spacing="12">

            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Text="扩展控件（ui:*）" />
            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="LightUi 自研：ToggleSwitch / FontIcon / SimpleStackPanel / HyperlinkButton / Flyout" />

            <!--  ToggleSwitch  -->
            <Border
                Padding="16"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="ToggleSwitch" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="20">
                        <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <ui:ToggleSwitch IsChecked="False" />
                            <TextBlock VerticalAlignment="Center" Text="关闭" />
                        </ui:SimpleStackPanel>
                        <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <ui:ToggleSwitch IsChecked="True" />
                            <TextBlock VerticalAlignment="Center" Text="打开" />
                        </ui:SimpleStackPanel>
                        <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <ui:ToggleSwitch IsChecked="True" IsEnabled="False" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Disabled" />
                        </ui:SimpleStackPanel>
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

            <!--  FontIcon  -->
            <Border
                Padding="16"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="FontIcon（Segoe Fluent Icons）" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="16">
                        <ui:SimpleStackPanel Spacing="4">
                            <ui:FontIcon Glyph="&#xE710;" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Add (E710)" />
                        </ui:SimpleStackPanel>
                        <ui:SimpleStackPanel Spacing="4">
                            <ui:FontIcon Foreground="{DynamicResource AccentBrush}" Glyph="&#xE74D;" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Delete (E74D)" />
                        </ui:SimpleStackPanel>
                        <ui:SimpleStackPanel Spacing="4">
                            <ui:FontIcon Glyph="&#xE713;" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Settings (E713)" />
                        </ui:SimpleStackPanel>
                        <ui:SimpleStackPanel Spacing="4">
                            <ui:FontIcon Glyph="&#xE70D;" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Chevron Down (E70D)" />
                        </ui:SimpleStackPanel>
                        <ui:SimpleStackPanel Spacing="4">
                            <ui:FontIcon Glyph="&#xE10A;" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Cancel (E10A)" />
                        </ui:SimpleStackPanel>
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

            <!--  SimpleStackPanel 演示  -->
            <Border
                Padding="16"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="SimpleStackPanel（带 Spacing 的 Panel）" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="横向 Spacing=12" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                        <Border
                            Padding="12,6"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="3">
                            <TextBlock Foreground="{DynamicResource AccentForegroundBrush}" Text="Item 1" />
                        </Border>
                        <Border
                            Padding="12,6"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="3">
                            <TextBlock Foreground="{DynamicResource AccentForegroundBrush}" Text="Item 2" />
                        </Border>
                        <Border
                            Padding="12,6"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="3">
                            <TextBlock Foreground="{DynamicResource AccentForegroundBrush}" Text="Item 3" />
                        </Border>
                        <Border
                            Padding="12,6"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="3">
                            <TextBlock Foreground="{DynamicResource AccentForegroundBrush}" Text="Item 4" />
                        </Border>
                    </ui:SimpleStackPanel>

                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="纵向 Spacing=8" />
                    <ui:SimpleStackPanel Orientation="Vertical" Spacing="8">
                        <Border
                            Padding="12,6"
                            Background="{DynamicResource ControlBackgroundSubtleBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                            <TextBlock Text="Row 1" />
                        </Border>
                        <Border
                            Padding="12,6"
                            Background="{DynamicResource ControlBackgroundSubtleBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                            <TextBlock Text="Row 2" />
                        </Border>
                        <Border
                            Padding="12,6"
                            Background="{DynamicResource ControlBackgroundSubtleBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                            <TextBlock Text="Row 3" />
                        </Border>
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

            <!--  Flyout 演示  -->
            <Border
                Padding="16"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="Flyout（依附弹出）" />
                    <ui:DropDownButton Content="点击我弹 Flyout">
                        <ui:DropDownButton.Flyout>
                            <ui:Flyout>
                                <ui:SimpleStackPanel Width="260" Spacing="8">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="Flyout 内容" />
                                    <TextBlock
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Text="Flyout 是依附控件的弹出层，可以承载任意 XAML 内容。"
                                        TextWrapping="Wrap" />
                                </ui:SimpleStackPanel>
                            </ui:Flyout>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>
                </ui:SimpleStackPanel>
            </Border>

        </ui:SimpleStackPanel>

    </ScrollViewer>
</UserControl>
