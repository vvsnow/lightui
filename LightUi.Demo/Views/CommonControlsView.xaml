<UserControl
    x:Class="LightUi.Demo.Views.CommonControlsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LightUi.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lightui.com/2019"
    d:DesignHeight="950"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <ScrollViewer Padding="22" VerticalScrollBarVisibility="Auto">

        <ui:SimpleStackPanel Spacing="12">

            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Text="内置 WPF 控件" />
            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="被 LightUi styles/ 重新样式化过的常见控件" />

            <!--  CheckBox  -->
            <Border
                Padding="16"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="CheckBox" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="16">
                        <CheckBox Content="未选中" />
                        <CheckBox Content="已选中" IsChecked="True" />
                        <CheckBox Content="Disabled" IsEnabled="False" />
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

            <!--  RadioButton  -->
            <Border
                Padding="16"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="RadioButton（一组）" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="16">
                        <RadioButton Content="选项 A" GroupName="g1" />
                        <RadioButton
                            Content="选项 B"
                            GroupName="g1"
                            IsChecked="True" />
                        <RadioButton Content="选项 C" GroupName="g1" />
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

            <!--  TextBox + PasswordBox  -->
            <Border
                Padding="16"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="TextBox / PasswordBox" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                        <TextBox Width="200" Text="普通文本" />
                        <TextBox
                            Width="200"
                            IsEnabled="False"
                            Text="Disabled" />
                        <PasswordBox Width="200" Password="placeholder" />
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

            <!--  ComboBox  -->
            <Border
                Padding="16"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="ComboBox（下拉选择）" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                        <ComboBox Width="180" ItemsSource="{Binding FruitItems}" />
                        <ComboBox
                            Width="180"
                            ItemsSource="{Binding FruitItems}"
                            SelectedItem="{Binding SelectedFruit}" />
                        <ComboBox
                            Width="180"
                            IsEnabled="False"
                            ItemsSource="{Binding FruitItems}"
                            SelectedItem="{Binding SelectedFruit}" />
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

            <!--  ListBox  -->
            <Border
                Padding="16"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="ListBox（水果列表）" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ListBox
                            MaxHeight="140"
                            ItemsSource="{Binding FruitItems}"
                            SelectedItem="{Binding SelectedFruit}" />
                        <ui:SimpleStackPanel
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Spacing="4">
                            <TextBlock
                                FontSize="12"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="当前选中" />
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Text="{Binding SelectedFruit}" />
                        </ui:SimpleStackPanel>
                    </Grid>
                </ui:SimpleStackPanel>
            </Border>

            <!--  ProgressBar  -->
            <Border
                Padding="16"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <ui:SimpleStackPanel Spacing="8">
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="ProgressBar" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="确定 65%" />
                    <ProgressBar Height="6" Value="65" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="Indeterminate" />
                    <ProgressBar Height="6" IsIndeterminate="True" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="完成 100%" />
                    <ProgressBar Height="6" Value="100" />
                </ui:SimpleStackPanel>
            </Border>

            <!--  ToolTip  -->
            <Border
                Padding="16"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="ToolTip（hover 触发）" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="6">
                        <Button
                            Content="tooltip 左"
                            ToolTip="这是左边的 tooltip"
                            ToolTipService.HorizontalOffset="-6"
                            ToolTipService.Placement="Left" />
                        <Button
                            Content="tooltip 右"
                            ToolTip="这是右边的 tooltip"
                            ToolTipService.HorizontalOffset="6"
                            ToolTipService.Placement="Right" />
                        <Button
                            Content="tooltip 上"
                            ToolTip="这是上面的 tooltip"
                            ToolTipService.Placement="Top"
                            ToolTipService.VerticalOffset="-6" />
                        <Button
                            Content="tooltip 下"
                            ToolTip="这是下面的 tooltip"
                            ToolTipService.Placement="Bottom"
                            ToolTipService.VerticalOffset="6" />
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

        </ui:SimpleStackPanel>

    </ScrollViewer>
</UserControl>
