<UserControl
    x:Class="LightUi.Demo.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LightUi.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lightui.com/2019"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">

        <ui:SimpleStackPanel Spacing="12">

            <!--  9 格 brush 色板  -->
            <TextBlock
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Text="调色板（9 个 brush）" />
            <TextBlock
                FontSize="12"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Text="切换主题后整张色板会同步翻转" />

            <UniformGrid Columns="3" Rows="3">

                <Border
                    Margin="4"
                    Padding="12"
                    Background="{DynamicResource PageBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <ui:SimpleStackPanel Spacing="4">
                        <TextBlock FontSize="12" Text="PageBackgroundBrush" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="窗口 / 页面背景" />
                    </ui:SimpleStackPanel>
                </Border>

                <Border
                    Margin="4"
                    Padding="12"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <ui:SimpleStackPanel Spacing="4">
                        <TextBlock FontSize="12" Text="ControlBackgroundBrush" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="卡片 / 输入控件底" />
                    </ui:SimpleStackPanel>
                </Border>

                <Border
                    Margin="4"
                    Padding="12"
                    Background="{DynamicResource ControlBackgroundSubtleBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <ui:SimpleStackPanel Spacing="4">
                        <TextBlock FontSize="12" Text="ControlBackgroundSubtleBrush" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="次级卡片底" />
                    </ui:SimpleStackPanel>
                </Border>

                <Border
                    Margin="4"
                    Padding="12"
                    Background="{DynamicResource ControlBackgroundHoverBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <ui:SimpleStackPanel Spacing="4">
                        <TextBlock FontSize="12" Text="ControlBackgroundHoverBrush" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="鼠标悬停" />
                    </ui:SimpleStackPanel>
                </Border>

                <Border
                    Margin="4"
                    Padding="12"
                    Background="{DynamicResource ControlBackgroundSelectedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <ui:SimpleStackPanel Spacing="4">
                        <TextBlock FontSize="12" Text="ControlBackgroundSelectedBrush" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="选中态" />
                    </ui:SimpleStackPanel>
                </Border>

                <Border
                    Margin="4"
                    Padding="12"
                    Background="{DynamicResource AccentBrush}"
                    CornerRadius="6">
                    <ui:SimpleStackPanel Spacing="4">
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource AccentForegroundBrush}"
                            Text="AccentBrush" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource AccentForegroundBrush}"
                            Text="强调色 / Primary 按钮" />
                    </ui:SimpleStackPanel>
                </Border>

                <Border
                    Margin="4"
                    Padding="12"
                    Background="{DynamicResource PageBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="2"
                    CornerRadius="6">
                    <ui:SimpleStackPanel Spacing="4">
                        <TextBlock FontSize="12" Text="BorderBrush" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="描边（边框）" />
                    </ui:SimpleStackPanel>
                </Border>

                <Border
                    Margin="4"
                    Padding="12"
                    Background="{DynamicResource PageBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <ui:SimpleStackPanel Spacing="4">
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="TextPrimaryBrush" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="主文字（标题、正文）" />
                    </ui:SimpleStackPanel>
                </Border>

                <Border
                    Margin="4"
                    Padding="12"
                    Background="{DynamicResource PageBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <ui:SimpleStackPanel Spacing="4">
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="TextSecondaryBrush" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="次文字（说明、辅助）" />
                    </ui:SimpleStackPanel>
                </Border>

            </UniformGrid>

        </ui:SimpleStackPanel>
    </ScrollViewer>
</UserControl>
