<UserControl
    x:Class="LightUi.Demo.Views.Pages.FlyoutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://caliburnmicro.com"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LightUi.Demo.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lightui.com/2019"
    xmlns:vm="clr-namespace:LightUi.Demo.ViewModels.Pages"
    d:DataContext="{d:DesignInstance Type=vm:FlyoutViewModel}"
    d:DesignHeight="1200"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <ScrollViewer Padding="22" VerticalScrollBarVisibility="Auto">

        <ui:SimpleStackPanel Spacing="12">

            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Flyout Control" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="ui:Flyout / ui:MenuFlyout (MenuItem inside) / ui:DropDownButton / ui:FlyoutService / ContextMenu" />

            <Border Style="{StaticResource ContainerStyle}">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="DropDownButton" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                        <ui:DropDownButton Content="新建">
                            <ui:DropDownButton.Flyout>
                                <ui:MenuFlyout>
                                    <MenuItem cal:Message.Attach="NewFile">
                                        <MenuItem.Header>
                                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="10">
                                                <ui:FontIcon FontSize="14" Glyph="&#xE8A5;" />
                                                <TextBlock VerticalAlignment="Center" Text="新建文件" />
                                            </ui:SimpleStackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem>
                                        <MenuItem.Header>
                                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="10">
                                                <ui:FontIcon FontSize="14" Glyph="&#xE7C3;" />
                                                <TextBlock VerticalAlignment="Center" Text="新建项目" />
                                            </ui:SimpleStackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem>
                                        <MenuItem.Header>
                                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="10">
                                                <ui:FontIcon FontSize="14" Glyph="&#xE710;" />
                                                <TextBlock VerticalAlignment="Center" Text="从模板新建…" />
                                            </ui:SimpleStackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                </ui:MenuFlyout>
                            </ui:DropDownButton.Flyout>
                        </ui:DropDownButton>
                        <ui:DropDownButton Content="操作">
                            <ui:DropDownButton.Flyout>
                                <ui:MenuFlyout>
                                    <MenuItem>
                                        <MenuItem.Header>
                                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="10">
                                                <ui:FontIcon FontSize="14" Glyph="&#xE8C8;" />
                                                <TextBlock VerticalAlignment="Center" Text="复制" />
                                            </ui:SimpleStackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem>
                                        <MenuItem.Header>
                                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="10">
                                                <ui:FontIcon FontSize="14" Glyph="&#xE77F;" />
                                                <TextBlock VerticalAlignment="Center" Text="粘贴" />
                                            </ui:SimpleStackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem>
                                        <MenuItem.Header>
                                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="10">
                                                <ui:FontIcon FontSize="14" Glyph="&#xE74D;" />
                                                <TextBlock VerticalAlignment="Center" Text="删除" />
                                            </ui:SimpleStackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                </ui:MenuFlyout>
                            </ui:DropDownButton.Flyout>
                        </ui:DropDownButton>
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

            <Border Style="{StaticResource ContainerStyle}">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Flyout（依附弹出）" />
                    <ui:DropDownButton Content="点击我弹 Flyout">
                        <ui:DropDownButton.Flyout>
                            <ui:Flyout>
                                <ui:SimpleStackPanel
                                    Width="260"
                                    Margin="10"
                                    Spacing="8">
                                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Flyout 内容" />
                                    <TextBlock
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Text="Flyout 是依附控件的弹出层，可以承载任意 XAML 内容。"
                                        TextWrapping="Wrap" />
                                    <ui:SimpleStackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Button Command="{x:Static ui:FlyoutBase.CloseCommand}" Content="关闭弹出" />
                                    </ui:SimpleStackPanel>
                                </ui:SimpleStackPanel>
                            </ui:Flyout>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>
                </ui:SimpleStackPanel>
            </Border>

            <Border Style="{StaticResource ContainerStyle}">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Button + Flyout" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="普通按钮 挂 Flyout">
                            <ui:FlyoutService.Flyout>
                                <ui:Flyout IsOpen="{Binding IsFlyout, Mode=TwoWay}">
                                    <Border Padding="12">
                                        <ui:SimpleStackPanel Spacing="12">
                                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Status}" />
                                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                                                <Button Content="主题按钮" Style="{StaticResource AccentButtonStyle}" />
                                                <Button
                                                    cal:Message.Attach="CloseFlyout"
                                                    Command="{x:Static ui:FlyoutBase.CloseCommand}"
                                                    Content="关闭弹出" />
                                            </ui:SimpleStackPanel>
                                        </ui:SimpleStackPanel>
                                    </Border>
                                </ui:Flyout>
                            </ui:FlyoutService.Flyout>
                        </Button>
                        <Button Content="普通 Button 挂 MenuFlyout">
                            <ui:FlyoutService.Flyout>
                                <ui:MenuFlyout>
                                    <MenuItem Header="选项 1" />
                                    <MenuItem Header="选项 2" />
                                    <Separator />
                                    <!--  二级菜单：MenuFlyout 的宿主是 ContextMenu(MenuBase)，
                                          嵌一层 MenuItem 就自动成为 SubmenuHeader —— 样式里 Role=SubmenuHeader
                                          那条触发器负责显示右侧箭头、并把 PART_Popup 改成向右展开  -->
                                    <MenuItem Header="更多…">
                                        <MenuItem Header="二级选项 1" />
                                        <MenuItem Header="二级选项 2" />
                                        <Separator />
                                        <MenuItem Header="二级选项 3" />
                                    </MenuItem>
                                </ui:MenuFlyout>
                            </ui:FlyoutService.Flyout>
                        </Button>
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

            <Border Style="{StaticResource ContainerStyle}">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Placement（四个方向）" />
                    <TextBlock
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="四个方向与宿主之间都留 2px 缝（FlyoutBase.PlacementGap）；这里用 Button + FlyoutService，因为 DropDownButton 会把 Placement 强制成 Bottom。"
                        TextWrapping="Wrap" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="向上弹">
                            <ui:FlyoutService.Flyout>
                                <ui:Flyout Placement="Top">
                                    <TextBlock Margin="10" Text="Placement = Top" />
                                </ui:Flyout>
                            </ui:FlyoutService.Flyout>
                        </Button>
                        <Button Content="向下弹">
                            <ui:FlyoutService.Flyout>
                                <ui:Flyout Placement="Bottom">
                                    <TextBlock Margin="10" Text="Placement = Bottom" />
                                </ui:Flyout>
                            </ui:FlyoutService.Flyout>
                        </Button>
                        <Button Content="向左弹">
                            <ui:FlyoutService.Flyout>
                                <ui:Flyout Placement="Left">
                                    <TextBlock Margin="10" Text="Placement = Left" />
                                </ui:Flyout>
                            </ui:FlyoutService.Flyout>
                        </Button>
                        <Button Content="向右弹">
                            <ui:FlyoutService.Flyout>
                                <ui:Flyout Placement="Right">
                                    <TextBlock Margin="10" Text="Placement = Right" />
                                </ui:Flyout>
                            </ui:FlyoutService.Flyout>
                        </Button>
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

            <Border Style="{StaticResource ContainerStyle}">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="ContextMenu（右键弹出）" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="挂在控件上的普通 ContextMenu，吃的是 LightUi 的 ContextMenu 样式（圆角 / 阴影 / 偏移补偿）。注意：TextBox 不挂自己的菜单时，弹的是 WPF 内部类型，吃不到隐式样式。"
                        TextWrapping="Wrap" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="右键点我（普通 ContextMenu）">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <!--  InputGestureText 只是右侧那列提示文字，这里没绑命令  -->
                                    <MenuItem Header="复制" InputGestureText="Ctrl+C" />
                                    <MenuItem Header="粘贴" InputGestureText="Ctrl+V" />
                                    <Separator />
                                    <MenuItem Header="更多…">
                                        <MenuItem Header="二级选项 1" />
                                        <MenuItem Header="二级选项 2" />
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <TextBox
                            Width="220"
                            ui:TextBoxHelper.Placeholder="右键我：这是自己挂的菜单">
                            <TextBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="我自己的菜单项 1" />
                                    <MenuItem Header="我自己的菜单项 2" />
                                </ContextMenu>
                            </TextBox.ContextMenu>
                        </TextBox>
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

        </ui:SimpleStackPanel>

    </ScrollViewer>

</UserControl>
