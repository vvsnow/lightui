<UserControl
    x:Class="LightUi.Demo.Views.Pages.ExtendedControlsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LightUi.Demo.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lightui.com/2019"
    d:DesignHeight="1200"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <ScrollViewer Padding="22" VerticalScrollBarVisibility="Auto">

        <ui:SimpleStackPanel Spacing="12">

            <TextBlock Style="{StaticResource TitleTextStyle}" Text="Extended Control" />
            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="ui:ToggleSwitch / ui:FontIcon / ui:SimpleStackPanel" />

            <Border Style="{StaticResource ContainerStyle}">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="ToggleSwitch" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                        <ui:ToggleSwitch
                            IsChecked="False"
                            OffContent="关闭"
                            OnContent="打开" />
                        <ui:ToggleSwitch
                            IsChecked="True"
                            OffContent="关闭"
                            OnContent="打开" />
                        <ui:ToggleSwitch
                            IsChecked="True"
                            IsEnabled="False"
                            OffContent="关闭"
                            OnContent="打开" />
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

            <Border Style="{StaticResource ContainerStyle}">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="FontIcon（系统图标字体）" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                        <ui:SimpleStackPanel Spacing="4">
                            <ui:FontIcon FontSize="18" Glyph="&#xE710;" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Add (E710)" />
                        </ui:SimpleStackPanel>
                        <ui:SimpleStackPanel Spacing="4">
                            <ui:FontIcon
                                FontSize="18"
                                Foreground="{DynamicResource AccentBrush}"
                                Glyph="&#xE74D;" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Delete (E74D)" />
                        </ui:SimpleStackPanel>
                        <ui:SimpleStackPanel Spacing="4">
                            <ui:FontIcon FontSize="18" Glyph="&#xE713;" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Settings (E713)" />
                        </ui:SimpleStackPanel>
                        <ui:SimpleStackPanel Spacing="4">
                            <ui:FontIcon
                                FontSize="18"
                                Foreground="{DynamicResource AccentBrush}"
                                Glyph="&#xE70D;" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Chevron Down (E70D)" />
                        </ui:SimpleStackPanel>
                        <ui:SimpleStackPanel Spacing="4">
                            <ui:FontIcon FontSize="18" Glyph="&#xE10A;" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="Cancel (E10A)" />
                        </ui:SimpleStackPanel>
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

            <Border Style="{StaticResource ContainerStyle}">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="SimpleStackPanel（带 Spacing 的 Panel）" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="横向 Spacing=12" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Item1" Style="{DynamicResource AccentButtonStyle}" />
                        <Button Content="Item2" Style="{DynamicResource AccentButtonStyle}" />
                        <Button Content="Item3" Style="{DynamicResource AccentButtonStyle}" />
                        <Button Content="Item4" Style="{DynamicResource AccentButtonStyle}" />
                    </ui:SimpleStackPanel>

                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="纵向 Spacing=8" />
                    <ui:SimpleStackPanel Orientation="Vertical" Spacing="8">
                        <Button Content="Item1" Style="{DynamicResource AccentButtonStyle}" />
                        <Button Content="Item2" Style="{DynamicResource AccentButtonStyle}" />
                        <Button Content="Item3" Style="{DynamicResource AccentButtonStyle}" />

                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

        </ui:SimpleStackPanel>

    </ScrollViewer>

</UserControl>
