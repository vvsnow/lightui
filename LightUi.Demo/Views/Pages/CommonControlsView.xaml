<UserControl
    x:Class="LightUi.Demo.Views.Pages.CommonControlsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LightUi.Demo.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lightui.com/2019"
    xmlns:vm="clr-namespace:LightUi.Demo.ViewModels.Pages"
    d:DataContext="{d:DesignInstance Type=vm:CommonControlsViewModel}"
    d:DesignHeight="1200"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <ScrollViewer Padding="22" VerticalScrollBarVisibility="Auto">

        <ui:SimpleStackPanel Spacing="12">

            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Common Controls" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="CheckBox / RadioButton / TextBox / PasswordBox / ComboBox / ListBox / ProgressBar / ToolTip / TabControl / Expander — WPF controls restyled by LightUi" />

            <Border Style="{StaticResource ContainerStyle}">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="CheckBox" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                        <CheckBox Content="未选中" />
                        <CheckBox Content="已选中" IsChecked="True" />
                        <CheckBox Content="Disabled" IsEnabled="False" />
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

            <Border Style="{StaticResource ContainerStyle}">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="RadioButton（一组）" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                        <RadioButton Content="选项 A" GroupName="g1" />
                        <RadioButton
                            Content="选项 B"
                            GroupName="g1"
                            IsChecked="True" />
                        <RadioButton Content="选项 C" GroupName="g1" />
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

            <Border Style="{StaticResource ContainerStyle}">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="TextBox / PasswordBox" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                        <TextBox Width="200" ui:TextBoxHelper.Placeholder="普通文本" />
                        <PasswordBox Width="200" ui:TextBoxHelper.Placeholder="密码" />
                        <TextBox
                            Width="200"
                            IsEnabled="False"
                            Text="Disabled" />
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

            <Border Style="{StaticResource ContainerStyle}">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="ComboBox（下拉选择）" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                        <ComboBox
                            Width="180"
                            ItemsSource="{Binding FruitItems}"
                            SelectedItem="{Binding SelectedFruit}" />
                        <ComboBox
                            Width="180"
                            ItemsSource="{Binding FruitItems}"
                            SelectedItem="{Binding SelectedFruit}" />
                        <ComboBox
                            Width="180"
                            IsEnabled="False"
                            ItemsSource="{Binding FruitItems}"
                            SelectedItem="{Binding SelectedFruit}" />
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

            <Border Style="{StaticResource ContainerStyle}">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="ListBox（水果列表）" />
                    <ui:SimpleStackPanel Spacing="12">

                        <ui:SimpleStackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="4">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="当前选中" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                Text="{Binding SelectedFruit, Mode=OneWay}" />
                        </ui:SimpleStackPanel>

                        <ListBox
                            Grid.Column="1"
                            MinHeight="40"
                            MaxHeight="140"
                            ItemsSource="{Binding FruitItems}"
                            SelectedItem="{Binding SelectedFruit}" />
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

            <Border Style="{StaticResource ContainerStyle}">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="ProgressBar" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="确定 65%" />
                    <ProgressBar Value="65" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="Indeterminate" />
                    <ProgressBar IsIndeterminate="True" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="完成 100%" />
                    <ProgressBar Value="100" />
                </ui:SimpleStackPanel>
            </Border>

            <Border Style="{StaticResource ContainerStyle}">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="ToolTip（hover 触发）" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                        <Button
                            Content="tooltip 左"
                            ToolTip="这是左边的 tooltip"
                            ToolTipService.HorizontalOffset="-6"
                            ToolTipService.Placement="Left" />
                        <Button
                            Content="tooltip 右"
                            ToolTip="这是右边的 tooltip"
                            ToolTipService.HorizontalOffset="6"
                            ToolTipService.Placement="Right" />
                        <Button
                            Content="tooltip 上"
                            ToolTip="这是上面的 tooltip"
                            ToolTipService.Placement="Top"
                            ToolTipService.VerticalOffset="-6" />
                        <Button
                            Content="tooltip 下"
                            ToolTip="这是下面的 tooltip"
                            ToolTipService.Placement="Bottom"
                            ToolTipService.VerticalOffset="6" />
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

            <Border Style="{StaticResource ContainerStyle}">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="TabControl" />
                    <TabControl BorderThickness="0">
                        <TabItem>
                            <TabItem.Header>
                                <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                    <ui:FontIcon VerticalAlignment="Center" Glyph="&#xE700;" />
                                    <TextBlock VerticalAlignment="Center" Text="选项 A" />
                                </ui:SimpleStackPanel>
                            </TabItem.Header>
                            <Border Margin="0,8">
                                <TextBlock Text="这是选项 A 的内容。点其它 tab 切到这里。" />
                            </Border>
                        </TabItem>
                        <TabItem Header="选项 B" IsSelected="True">
                            <Border Margin="0,8">
                                <TextBlock Text="这是选项 B 的内容。IsSelected=True 初始化时就是选中态 —— 只有选中那个有选中外观。" />
                            </Border>
                        </TabItem>
                        <TabItem Header="选项 C">
                            <Border Margin="0,8">
                                <TextBlock Text="这是选项 C 的内容。" />
                            </Border>
                        </TabItem>
                        <TabItem Header="Disabled" IsEnabled="False">
                            <Border Margin="0,8">
                                <TextBlock Text="不可用" />
                            </Border>
                        </TabItem>
                    </TabControl>
                </ui:SimpleStackPanel>
            </Border>

            <Border Style="{StaticResource ContainerStyle}">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Expander（折叠面板）" />
                    <ui:SimpleStackPanel Spacing="12">
                        <Expander>
                            <Expander.Header>
                                <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                    <ui:FontIcon Margin="0,2.8,0,0" Glyph="&#xE700;" />
                                    <TextBlock Text="折叠面板标题" />
                                </ui:SimpleStackPanel>
                            </Expander.Header>
                            <ui:SimpleStackPanel Spacing="6">
                                <TextBlock Text="这是一个 60px 高的卡片化 Expander。区背景比头部略浅一档，更贴近 Win11。" TextWrapping="Wrap" />
                                <TextBlock Text="这是一个 60px 高的卡片化 Expander 区背景比头部略浅一档，更贴近 Win11。" TextWrapping="Wrap" />
                            </ui:SimpleStackPanel>

                        </Expander>
                        <Expander Header="默认展开" IsExpanded="True">
                            <TextBlock Text="初始 IsExpanded=True，箭头已旋转 180°，分隔线可见。" TextWrapping="Wrap" />
                        </Expander>
                        <Expander Header="Disabled" IsEnabled="False">
                            <TextBlock Text="不可用" TextWrapping="Wrap" />
                        </Expander>
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>

            </Border>

        </ui:SimpleStackPanel>

    </ScrollViewer>

</UserControl>
