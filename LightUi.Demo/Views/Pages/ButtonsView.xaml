<UserControl
    x:Class="LightUi.Demo.Views.Pages.ButtonsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://caliburnmicro.com"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LightUi.Demo.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lightui.com/2019"
    xmlns:vm="clr-namespace:LightUi.Demo.ViewModels.Pages"
    d:DataContext="{d:DesignInstance Type=vm:ButtonsViewModel}"
    d:DesignHeight="1200"
    d:DesignWidth="600"
    mc:Ignorable="d">

    <ScrollViewer Padding="22" VerticalScrollBarVisibility="Auto">

        <ui:SimpleStackPanel Spacing="12">

            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Buttons" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="Button / CircleButtonStyle / RepeatButton / ToggleButton / ui:HyperlinkButton" />

            <Border Style="{StaticResource ContainerStyle}">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Button" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="普通按钮" />
                        <Button Content="Primary" Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="Disabled" IsEnabled="False" />
                        <Button Style="{DynamicResource AccentButtonStyle}">
                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="6">
                                <ui:FontIcon Glyph="&#xE710;" />
                                <TextBlock Text="带 FontIcon" />
                            </ui:SimpleStackPanel>
                        </Button>
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

            <Border Style="{StaticResource ContainerStyle}">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="CircleButtonStyle（圆形按钮）" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="默认无边框，hover 才描边；圆的大小由 Width 决定" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                        <Button VerticalAlignment="Center" Style="{StaticResource CircleButtonStyle}">
                            <ui:FontIcon Glyph="&#xE710;" />
                        </Button>
                        <Button VerticalAlignment="Center" Style="{StaticResource CircleButtonStyle}">
                            <ui:FontIcon Margin="10" Glyph="&#xE713;" />
                        </Button>
                        <Button VerticalAlignment="Center" Style="{StaticResource CircleButtonStyle}">
                            <ui:FontIcon FontSize="16" Glyph="&#xE721;" />
                        </Button>
                        <Button
                            VerticalAlignment="Center"
                            Content="文字"
                            Style="{StaticResource CircleButtonStyle}" />
                        <Button
                            VerticalAlignment="Center"
                            IsEnabled="False"
                            Style="{StaticResource CircleButtonStyle}">
                            <ui:FontIcon Glyph="&#xE74D;" />
                        </Button>
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

            <Border Style="{StaticResource ContainerStyle}">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="RepeatButton（按住连续）" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                        <RepeatButton
                            cal:Message.Attach="Increase"
                            Delay="200"
                            Interval="80">
                            <ui:FontIcon Glyph="&#xE710;" />
                        </RepeatButton>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="18"
                            Text="{Binding Counter}" />
                        <RepeatButton
                            cal:Message.Attach="Decrease"
                            Delay="200"
                            Interval="80">
                            <ui:FontIcon Glyph="&#xE738;" />
                        </RepeatButton>
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

            <Border Style="{StaticResource ContainerStyle}">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="ToggleButton" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                        <ToggleButton Content="未选中" />
                        <ToggleButton Content="已选中" IsChecked="True" />
                        <ToggleButton Content="Disabled" IsEnabled="False" />
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

            <Border Style="{StaticResource ContainerStyle}">
                <ui:SimpleStackPanel Spacing="12">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="HyperlinkButton" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                        <ui:HyperlinkButton Content="访问 GitHub" NavigateUri="https://github.com" />
                        <ui:HyperlinkButton Content="访问 NuGet" NavigateUri="https://www.nuget.org" />
                        <ui:HyperlinkButton Content="不跳转（纯样式）" />
                        <ui:HyperlinkButton cal:Message.Attach="DoSomeAction" Content="执行动作" />
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>

        </ui:SimpleStackPanel>

    </ScrollViewer>

</UserControl>
