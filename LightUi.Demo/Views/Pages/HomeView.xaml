<UserControl
    x:Class="LightUi.Demo.Views.Pages.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LightUi.Demo.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lightui.com/2019"
    d:DesignHeight="1200"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <ScrollViewer Padding="22" VerticalScrollBarVisibility="Auto">

        <ui:SimpleStackPanel Spacing="12">

            <TextBlock Style="{StaticResource TitleTextStyle}" Text="Home" />
            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="9 semantic brushes — switch theme and the whole palette flips" />

            <UniformGrid Columns="3" Rows="3">

                <Border Background="{DynamicResource PageBackgroundBrush}" Style="{StaticResource PaletteStyle}">
                    <ui:SimpleStackPanel Spacing="4">
                        <TextBlock FontSize="12" Text="PageBackgroundBrush" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="窗口 / 页面背景" />
                    </ui:SimpleStackPanel>
                </Border>

                <Border Background="{DynamicResource ControlBackgroundBrush}" Style="{StaticResource PaletteStyle}">
                    <ui:SimpleStackPanel Spacing="4">
                        <TextBlock FontSize="12" Text="ControlBackgroundBrush" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="卡片 / 输入控件底" />
                    </ui:SimpleStackPanel>
                </Border>

                <Border Background="{DynamicResource ControlSubtleBackgroundBrush}" Style="{StaticResource PaletteStyle}">
                    <ui:SimpleStackPanel Spacing="4">
                        <TextBlock FontSize="12" Text="ControlSubtleBackgroundBrush" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="次级卡片底" />
                    </ui:SimpleStackPanel>
                </Border>

                <Border Background="{DynamicResource ControlHoverBackgroundBrush}" Style="{StaticResource PaletteStyle}">
                    <ui:SimpleStackPanel Spacing="4">
                        <TextBlock FontSize="12" Text="ControlHoverBackgroundBrush" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="鼠标悬停" />
                    </ui:SimpleStackPanel>
                </Border>

                <Border Background="{DynamicResource ControlSelectedBackgroundBrush}" Style="{StaticResource PaletteStyle}">
                    <ui:SimpleStackPanel Spacing="4">
                        <TextBlock FontSize="12" Text="ControlSelectedBackgroundBrush" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="选中态" />
                    </ui:SimpleStackPanel>
                </Border>

                <!--
                    强调色方块原本没有描边：描边刷子设成 Transparent 而不是去掉 BorderThickness，
                    这样 1px 的内缩和其它方块一致，内容不会跟着挪位
                -->
                <Border
                    Background="{DynamicResource AccentBrush}"
                    BorderBrush="Transparent"
                    Style="{StaticResource PaletteStyle}">
                    <ui:SimpleStackPanel Spacing="4">
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource AccentForegroundBrush}"
                            Text="AccentBrush" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource AccentForegroundBrush}"
                            Text="强调色 / Primary 按钮" />
                    </ui:SimpleStackPanel>
                </Border>

                <Border Background="{DynamicResource PageBackgroundBrush}" Style="{StaticResource PaletteStyle}">
                    <ui:SimpleStackPanel Spacing="4">
                        <TextBlock FontSize="12" Text="BorderBrush" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="描边（边框）" />
                    </ui:SimpleStackPanel>
                </Border>

                <Border Background="{DynamicResource PageBackgroundBrush}" Style="{StaticResource PaletteStyle}">
                    <ui:SimpleStackPanel Spacing="4">
                        <TextBlock FontSize="12" Text="TextPrimaryBrush" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="主文字（标题、正文）" />
                    </ui:SimpleStackPanel>
                </Border>

                <Border Background="{DynamicResource PageBackgroundBrush}" Style="{StaticResource PaletteStyle}">
                    <ui:SimpleStackPanel Spacing="4">
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="TextSecondaryBrush" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="次文字（说明、辅助）" />
                    </ui:SimpleStackPanel>
                </Border>

            </UniformGrid>

            <Border Style="{StaticResource ContainerStyle}">
                <ui:SimpleStackPanel Spacing="8">
                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="WarningBrush（警告文字）" />
                    <TextBlock
                        FontSize="{DynamicResource ControlFontSize}"
                        Foreground="{DynamicResource WarningBrush}"
                        Text="这是一条警告文字：颜色随主题在 #C2410C（浅色）/ #FFA033（深色）之间切换。"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontSize="{DynamicResource TextSecondaryFontSize}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="用于危险 / 警告提示的字体颜色。"
                        TextWrapping="Wrap" />
                </ui:SimpleStackPanel>
            </Border>

        </ui:SimpleStackPanel>
    </ScrollViewer>
</UserControl>
