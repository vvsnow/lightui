<UserControl
    x:Class="LightUi.Demo.Views.Pages.FramelessHelperView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LightUi.Demo.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lightui.com/2019"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Border Style="{StaticResource ContainerStyle}">
        <ui:SimpleStackPanel Spacing="10">
            <Button x:Name="ShowFramelessWindow" Content="打开FramelessWindow" />
        </ui:SimpleStackPanel>
    </Border>
</UserControl>
