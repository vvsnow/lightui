<UserControl
    x:Class="LightUi.Demo.Views.Pages.FramelessHelperView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LightUi.Demo.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lightui.com/2019"
    d:DesignHeight="1200"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">

        <ui:SimpleStackPanel Spacing="12">

            <TextBlock Style="{StaticResource TitleTextStyle}" Text="Frameless Helper" />
            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Opens a real frameless window — drag, 8-way resize, Snap, custom caption buttons" />

            <Border Style="{StaticResource ContainerStyle}">
                <ui:SimpleStackPanel Spacing="12">

                    <TextBlock Style="{StaticResource HeaderTextStyle}" Text="无边框窗口" />

                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="ShowFramelessWindow" Content="打开FramelessWindow" />
                    </ui:SimpleStackPanel>

                </ui:SimpleStackPanel>

            </Border>

        </ui:SimpleStackPanel>

    </ScrollViewer>

</UserControl>
