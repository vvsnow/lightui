<UserControl
    x:Class="LightUi.Demo.Views.Pages.VersionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LightUi.Demo.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lightui.com/2019"
    xmlns:vm="clr-namespace:LightUi.Demo.ViewModels.Pages"
    d:DataContext="{d:DesignInstance Type=vm:VersionViewModel}"
    d:DesignHeight="1200"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <ScrollViewer Padding="22" VerticalScrollBarVisibility="Auto">

        <ui:SimpleStackPanel Spacing="12">

            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Version" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="Verison information" />

            <Border Style="{StaticResource ContainerStyle}">
                <ui:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock
                        d:Text="LightUi v1.0.2"
                        Style="{StaticResource HeaderTextStyle}"
                        Text="{Binding UiVersion, Mode=OneWay, StringFormat='LightUi v{0}'}" />
                    <TextBlock
                        VerticalAlignment="Bottom"
                        d:Text="Demo v1.0.2"
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="{Binding DemoVersion, Mode=OneWay, StringFormat='Demo v{0}'}" />
                </ui:SimpleStackPanel>
            </Border>

        </ui:SimpleStackPanel>
    </ScrollViewer>
</UserControl>
