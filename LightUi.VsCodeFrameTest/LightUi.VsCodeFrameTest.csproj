<Project Sdk="Microsoft.NET.Sdk">

  <!--
      自包含的测试工程：验证「不用 WindowChrome、改用 Win32 消息自己处理非客户区」能不能
      让无边框窗口保住原生边框，从而消掉 Snap Layouts 的死区。

      刻意不引用 LightUi：整个工程可以单独拷到任何 WPF 项目里。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
