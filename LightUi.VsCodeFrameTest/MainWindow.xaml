<local:NativeFrameWindow
    x:Class="LightUi.VsCodeFrameTest.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:LightUi.VsCodeFrameTest"
    Title="Win32 无边框测试窗口"
    Width="1080"
    Height="720"
    Background="#FAFAFA"
    FontFamily="Segoe UI, Microsoft YaHei UI"
    FontSize="13"
    Foreground="#1F1F1F"
    ResizeMode="CanResize"
    TitlebarOverlayHeight="86"
    WindowStartupLocation="CenterScreen">
    <!--
        TitlebarOverlayHeight = 自定义标题栏高度（DIP），对应 Electron 的 titleBarOverlay.height。
        当前设成 36，实测按钮高度 36 - WindowTopY(1) = 35 DIP（默认不设时为 29 DIP）。
        设回 0（或删掉这个属性）就是「按系统度量算」的默认值。
        
        ★ 两个限制都来自参考实现的判断，不是我这边的毛病：
        · 只有比 SM_CYCAPTION（本机 23 DIP）**更高**才生效 —— 想调矮做不到；
        · 最大化的那一刻高度会自己变（默认是 23 DIP），因为 FrameTopBorderThickness(false) 变 0。
    -->


    <!--
        刻意不写 WindowStyle：必须保持默认的 SingleBorderWindow。
        窗口样式里带着 WS_THICKFRAME 才会有「不可见边框」—— 那正是系统计算 Snap Layouts 热区的锚点。
        写成 WindowStyle="None" 会退化成 WS_POPUP，这圈边框就没了。
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="86" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!--
            标题栏。高度由窗口过程算（WinFrameView::TitlebarHeight），这里不写死。
            四个按钮不写在 XAML 里 —— 和 Electron 一样由容器在构造时创建
            （WinCaptionButtonContainer 的构造函数里 AddChildView 那四行）。
        -->
        <Grid
            x:Name="PART_TitleBar"
            Grid.Row="0"
            Background="#FFFFFF">
            <TextBlock
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontSize="12"
                Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type local:NativeFrameWindow}}}" />

            <!--
                按钮宿主必须铺满整条标题栏（不要靠右对齐）：
                容器算出来的 Canvas.Left 是**客户区绝对坐标**，
                而客户区原点就是标题栏左上角，铺满才能对得上。
            -->
            <Canvas x:Name="PART_CaptionButtonHost" />
        </Grid>

        <!--  诊断面板：把「有没有不可见边框」直接画在界面上，截图就能看  -->
        <Border
            Grid.Row="1"
            Margin="16"
            Padding="16"
            Background="#FFFFFF"
            BorderBrush="#E5E5E5"
            BorderThickness="1"
            CornerRadius="6">
            <TextBlock
                x:Name="DiagnosticsText"
                FontFamily="Consolas, Microsoft YaHei UI"
                FontSize="12"
                LineHeight="19"
                TextWrapping="Wrap" />
        </Border>
    </Grid>
</local:NativeFrameWindow>
