<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        标题栏按钮的四个符号。

        对应 Electron 里 Windows11IconPainter / Windows10IconPainter 画的那四个图形
        （minimize / maximize / restore / close）。那边是用 Skia 描边画的，
        符号框边长 base::ClampRound(10 * scale)、描边宽度 ClampRound(scale)
        （见 WinCaptionButton::PaintSymbol），在 WPF 里就是 10 DIP 的框 + 1 DIP 描边。
        这里用 Path 几何表达；绘图在 C# 里（WinCaptionButtonContainer.Place）。
    -->

    <PathGeometry x:Key="GlyphMinimize" Figures="M 0,5 L 10,5" />

    <PathGeometry x:Key="GlyphMaximize" Figures="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z" />

    <!--  还原：两个错开的方框，照 Chromium 的 restore 图标  -->
    <PathGeometry x:Key="GlyphRestore" Figures="M 2.5,0.5 L 9.5,0.5 L 9.5,7.5 M 0.5,2.5 L 7.5,2.5 L 7.5,9.5 L 0.5,9.5 Z" />

    <PathGeometry x:Key="GlyphClose" Figures="M 0.5,0.5 L 9.5,9.5 M 9.5,0.5 L 0.5,9.5" />

</ResourceDictionary>
