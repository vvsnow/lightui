<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  尺寸资源（与主题无关，由 Size.xaml 提供）  -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/LightUi;component/Theme/Size.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  16 个 brush 键的深色实现  -->
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="ControlBackgroundSubtleBrush" Color="#252525" />
    <SolidColorBrush x:Key="ControlBackgroundHoverBrush" Color="#363636" />
    <SolidColorBrush x:Key="ControlBackgroundSelectedBrush" Color="#404040" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3F3F3F" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B0B0B0" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <!--  ToggleSwitch Thumb：暗主题里用浅灰而不是纯白，避免突兀  -->
    <SolidColorBrush x:Key="ToggleSwitchThumbBrush" Color="#E5E5E5" />

    <!--
        标题栏关闭键的悬停 / 按下底色和压在红底上的图标色。和 Light.xaml 取同一组值 ——
        系统自己的关闭键在深浅主题下就是这样，不跟着主题走。
        图标色单独开键，理由见 Light.xaml 的注释（不能复用会被 ApplyAccentColor 重算的 AccentForegroundBrush）。
    -->
    <SolidColorBrush x:Key="SystemCloseHoverBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="SystemClosePressedBrush" Color="#B02A1E" />
    <SolidColorBrush x:Key="SystemCloseForegroundBrush" Color="#FFFFFF" />

</ResourceDictionary>