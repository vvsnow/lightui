<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  尺寸资源（与主题无关，由 Size.xaml 提供）  -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/LightUi;component/Theme/Size.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="BorderBrush" Color="#4A4A4A" />

    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="ControlSubtleBackgroundBrush" Color="#252525" />
    <SolidColorBrush x:Key="ControlHoverBackgroundBrush" Color="#363636" />
    <SolidColorBrush x:Key="ControlSelectedBackgroundBrush" Color="#404040" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B0B0B0" />

    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />

    <!--  键盘焦点环的颜色，样式在 styles/FocusVisual.xaml。浅色主题那份在 Light.xaml  -->
    <SolidColorBrush x:Key="FocusVisualBrush" Color="#B4B4B4" />

    <SolidColorBrush x:Key="ToggleSwitchThumbBrush" Color="#E5E5E5" />

    <SolidColorBrush x:Key="ProgressBackgroundBrush" Color="#505050" />

    <SolidColorBrush x:Key="ScrollBackgroundBrush" Color="#505050" />


    <SolidColorBrush x:Key="SystemCloseHoverBrush" Color="#D42B1C" />
    <SolidColorBrush x:Key="SystemClosePressedBrush" Color="#BF2A1E" />
    <SolidColorBrush x:Key="SystemCloseForegroundBrush" Color="#FFFFFF" />

    <!--  弹层阴影：整个 Effect 放主题里（不放模板），切主题时颜色 / 模糊 / 浓度都能各自调；深色主题用黑，浅灰在深底上会变成发光边  -->
    <DropShadowEffect
        x:Key="FlyoutShadowEffect"
        BlurRadius="10"
        Direction="270"
        Opacity="0.4"
        Color="#000000" />

</ResourceDictionary>