<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        尺寸类资源（与主题无关 —— Light / Dark 共用一套）。
        
        由 Light.xaml / Dark.xaml 通过 MergedDictionaries 引入，而不是写进 App.Resources：
        ResourceDictionary.Keys 只列自身定义的 key，合并进来的不会被列出 ——
        所以 ThemeManager「枚举 palette.Keys 写回 target」的流程碰不到尺寸资源。
        
        分组（自上而下）：
        高度      控件 / 菜单项 / 容器卡片 自身的纵向高度
        线维度    边框、padding、滚动条、分隔线 等线性度量
        字号      主字号 / 图标字号 / 标题栏图标字号 / 次级字号
        圆角      控件 / 浮层 / 容器卡片 三档
          状态      禁用态的 Opacity（IsEnabled=False 触发器复用）
        
        需要额外解释的只有这几条：
        MenuItemHeight        = ControlHeight − 2×ControlBorderThickness
        ControlGlyphFontSize  与 CaptionGlyphFontSize 刻意分开（控件图标 / 标题栏图标两套规格）
        
        ToggleSwitch 圆轨 9 是 pill 形硬编码（控件高度一半 + 余量），不进资源。
        要按主题差异化尺寸，在对应主题里 Override 即可。
    -->


    <!--  ─────────  高度  ─────────  -->

    <sys:Double x:Key="ControlHeight">28</sys:Double>

    <!--
        菜单项自身高度 = ControlHeight − 2 × ControlBorderThickness。
        菜单项外面还裹着 MenuFlyout 的 1px 边框（上下各 1px），直接按 28 算会比 Button 高 2px。
        
        改 ControlHeight 时记得一并改这里 —— DynamicResource 不能经过转换器，
        XAML 里表达不出这个减法，编译器不会提醒你。
    -->
    <sys:Double x:Key="MenuItemHeight">26</sys:Double>

    <!--  Expander 折叠态头部位默认高度（用户要求 50；可按主题差异化覆盖）  -->
    <sys:Double x:Key="ExpanderHeaderHeight">50</sys:Double>


    <!--  ─────────  线维度  ─────────  -->

    <!--
        类型必须是 Thickness，不能是 sys:Double —— 它只用在 BorderThickness 上（14 处），
        而 Thickness 属性拿到 boxed double 会抛"__不是属性 BorderThickness 的有效值"。
        （对照：ControlPaddingHorizontal 也用在这个属性上，所以同样是 <Thickness>。）
    -->
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <Thickness x:Key="ControlPaddingHorizontal">12,0</Thickness>

    <!--  滚动条厚度：垂直条的 Width/MinWidth 与水平条的 Height/MinHeight 共用这一个值  -->
    <sys:Double x:Key="ScrollBarThickness">12</sys:Double>

    <!--
        分隔线厚度。虽是 1，但是个"规格"而不是随手写的值：配合 SnapsToDevicePixels +
        UseLayoutRounding，对齐全 1 物理像素才是一条锐利细线；缩放非 100% 时不对齐会被抗锯齿糊成灰带。
    -->
    <sys:Double x:Key="SeparatorThickness">1</sys:Double>


    <!--  ─────────  字号  ─────────  -->

    <sys:Double x:Key="ControlFontSize">13</sys:Double>

    <!--  库内图标（FontIcon）统一字号，也是 FontIcon 默认字号。与 CaptionGlyphFontSize 分开，别互相牵连。  -->
    <sys:Double x:Key="ControlGlyphFontSize">14</sys:Double>

    <!--  次级文字字号：菜单项右侧的快捷键列、ToolTip 正文（对齐已有的 TextSecondaryBrush 命名）  -->
    <sys:Double x:Key="TextSecondaryFontSize">12</sys:Double>

    <!--
        自绘标题栏三个系统按钮（最小化 / 最大化 / 关闭）的图标字号。
        刻意不复用 ControlFontSize：改控件字号不该顺手把标题栏图标也改了。
        三个图标共用一个值；字形视觉重量本就不齐（方框比横线/叉"重"），要拉平靠微调而非拆成三份。
    -->
    <sys:Double x:Key="CaptionGlyphFontSize">13</sys:Double>


    <!--  ─────────  圆角  ─────────  -->

    <CornerRadius x:Key="ControlCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">4</CornerRadius>

    <!--
        容器型卡片（Expander / TabControl）圆角：6 是与 ControlCornerRadius(3) / OverlayCornerRadius(4) 的折中，
        也与 lightui demo 卡普遍使用的 6 对齐；单独 key 方便后续按主题或设计稿再调。
    -->
    <CornerRadius x:Key="ContainerCornerRadius">6</CornerRadius>


    <!--  ─────────  状态  ─────────  -->

    <!--
        控件禁用态的 Opacity：所有 IsEnabled=False 触发器共用此值。
        统一调亮一点（比如 0.7 → 减弱视觉弱化），整套控件一起变；避免逐个 Style 散写。
    -->
    <sys:Double x:Key="DisabledOpacity">0.5</sys:Double>

</ResourceDictionary>