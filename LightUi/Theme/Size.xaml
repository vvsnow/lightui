<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--  与主题无关，由 Light / Dark 合并进来而不是写进 App.Resources：ResourceDictionary.Keys 只列自身 key，ThemeManager 扫不到它  -->


    <!--  ─────────  高度  ─────────  -->

    <sys:Double x:Key="ControlHeight">28</sys:Double>

    <!--
        菜单项高度 = ControlHeight − 2 × ControlBorderThickness（外面还裹着菜单的 1px 边框）。
        改 ControlHeight 时记得一并改这里 —— XAML 里表达不出这个减法，编译器不会提醒你。
    -->
    <sys:Double x:Key="MenuItemHeight">26</sys:Double>

    <!--  ─────────  线维度  ─────────  -->

    <!--  必须是 Thickness 不能是 sys:Double：它只用在 BorderThickness 上，拿到 boxed double 会抛「不是有效值」  -->
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <Thickness x:Key="ControlPaddingHorizontal">12,0</Thickness>

    <!--  滚动条厚度：垂直条的 Width/MinWidth 与水平条的 Height/MinHeight 共用这一个值  -->
    <sys:Double x:Key="ScrollBarThickness">12</sys:Double>

    <!--  配合 SnapsToDevicePixels + UseLayoutRounding：缩放非 100% 时不对齐会被抗锯齿糊成两倍宽的灰带  -->
    <sys:Double x:Key="SeparatorThickness">1</sys:Double>


    <!--  ─────────  字号  ─────────  -->

    <sys:Double x:Key="ControlFontSize">13</sys:Double>

    <!--  FontIcon 的统一字号；与 CaptionGlyphFontSize 分开，别互相牵连  -->
    <sys:Double x:Key="ControlGlyphFontSize">14</sys:Double>

    <sys:Double x:Key="TextSecondaryFontSize">12</sys:Double>

    <!--  标题栏三颗系统按钮的图标字号；刻意不复用 ControlFontSize（改控件字号不该顺手动标题栏）  -->
    <sys:Double x:Key="CaptionGlyphFontSize">13</sys:Double>


    <!--  ─────────  圆角  ─────────  -->

    <CornerRadius x:Key="ControlCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">4</CornerRadius>

    <!--  容器卡片（Expander / TabControl）圆角：3 与 4 两档的折中，单独一个 key 方便再调  -->
    <CornerRadius x:Key="ContainerCornerRadius">6</CornerRadius>


    <!--  ─────────  状态  ─────────  -->

    <!--  所有 IsEnabled=False 触发器共用这一个值，避免各 Style 散写  -->
    <sys:Double x:Key="DisabledOpacity">0.5</sys:Double>


    <!--  ─────────  形状  ─────────  -->

    <!--  V 形箭头（ChevronDown）几何：DropDownButton / ComboBox / Expander 三处共用  -->
    <StreamGeometry x:Key="ChevronDownGeometry">M0,3 L5,7 L10,3</StreamGeometry>

</ResourceDictionary>