<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  尺寸资源（与主题无关，由 Size.xaml 提供）  -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/LightUi;component/Theme/Size.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="BorderBrush" Color="#D3D3D3" />

    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F8F8F8" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlSubtleBackgroundBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="ControlHoverBackgroundBrush" Color="#EEEEEE" />
    <SolidColorBrush x:Key="ControlSelectedBackgroundBrush" Color="#E5E5E5" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B6B6B" />

    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1E40AF" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />

    <!--  键盘焦点环的颜色，样式在 styles/FocusVisual.xaml。深色主题那份在 Dark.xaml  -->
    <SolidColorBrush x:Key="FocusVisualBrush" Color="#333333" />

    <SolidColorBrush x:Key="ToggleSwitchThumbBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="ProgressBackgroundBrush" Color="#E0E0E0" />

    <SolidColorBrush x:Key="ScrollBackgroundBrush" Color="#E0E0E0" />


    <SolidColorBrush x:Key="SystemCloseHoverBrush" Color="#D42B1C" />
    <SolidColorBrush x:Key="SystemClosePressedBrush" Color="#BF2A1E" />
    <SolidColorBrush x:Key="SystemCloseForegroundBrush" Color="#FFFFFF" />

    <!--  弹层阴影：整个 Effect 放主题里（不放模板），切主题时颜色 / 模糊 / 浓度都能各自调；浅色主题用浅灰做柔和投影  -->
    <DropShadowEffect
        x:Key="FlyoutShadowEffect"
        BlurRadius="10"
        Direction="270"
        Opacity="0.4"
        Color="#DDDDDD" />

</ResourceDictionary>