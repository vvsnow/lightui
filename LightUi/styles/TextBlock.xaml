<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        TextBlock 默认样式：
        - FontSize = ControlFontSize（与项目内 Button / CheckBox 等控件同款字号，保持排版一致）
        - 不设 Foreground：让 TextBlock 的前景色从父级继承（Button / TabItem / 列表项 … 改了 Foreground 就跟着改）。
        同 FontIcon 的处理 —— 一旦在这里写具体 brush，local value 会盖掉继承。
        独立使用的 TextBlock 没父级 Foreground 时会回退到系统 WindowTextBrushKey，跟随系统主题。
    -->



    <Style x:Key="DefaultTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
    </Style>

    <Style
        x:Key="HeaderTextStyle"
        BasedOn="{StaticResource DefaultTextStyle}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style BasedOn="{StaticResource DefaultTextStyle}" TargetType="{x:Type TextBlock}" />

</ResourceDictionary>