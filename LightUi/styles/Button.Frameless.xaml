<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        尺寸是样式自己的资源，**与 caption 高度无关** —— caption 高度只用于命中判定（多高算拖动区）。
        悬停/按下主要不在这里上色：返回 HT* 之后那块是非客户区，IsMouseOver 恒为 false，
        真正的悬停色在 DefaultFramelessWindowStyle 的模板触发器里；下面那两个只作**兜底**
        （布局完成前命中会回落到 WPF 输入，那时按钮就是普通 WPF 按钮）。
        ★ 刻意不 BasedOn 任何按钮样式：跨字典的 {StaticResource} 在合并进来的子字典里搜不到，
        启动会抛「无法找到名为 … 的资源」（合并顺序也解决不了）—— 所以这里自带全套 setter。
    -->

    <sys:Double x:Key="FramelessCaptionButtonWidth">46</sys:Double>
    <sys:Double x:Key="FramelessCaptionButtonHeight">30</sys:Double>

    <Style x:Key="FramelessSystemButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="{DynamicResource FramelessCaptionButtonWidth}" />
        <Setter Property="Height" Value="{DynamicResource FramelessCaptionButtonHeight}" />
        <Setter Property="MinHeight" Value="0" />
        <!--  必须显式给前景色：FontIcon 不设 Foreground、靠继承，本样式又不 BasedOn，不写就落到默认黑 —— 深色主题看不见  -->
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <!--  命中由 FramelessHelper 判（返回 HT* 码）；留着 True 会让「逃生出口」那一判在按钮上多嘴  -->
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ControlSelectedBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  关闭键：尺寸与其它两颗一致，只有配色不同。BasedOn 是同文件的（能解析）  -->
    <Style
        x:Key="FramelessCloseButtonStyle"
        BasedOn="{StaticResource FramelessSystemButtonStyle}"
        TargetType="Button">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SystemCloseHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SystemCloseForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource SystemClosePressedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SystemCloseForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
