<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:LightUi.Controls">

    <!--
        WPF 自带 ProgressBar 的默认样式 —— 只是个「壳子」。
        模板根元素是 <local:ProgressBar />（LightUi 自定义控件），WPF 侧属性经 TemplateBinding 透传，
        所以用户照常写 <ProgressBar Value="65" IsIndeterminate="True" /> 就能拿到 LightUi 风格。
        真正的可视逻辑与动画在 controls/ProgressBar/ProgressBar.xaml。
        与 ModernWpf 的 Styles/ProgressBar.xaml 同一套做法。
    -->

    <Style TargetType="ProgressBar">
        <!--  隔断 WPF 默认主题样式里其余的 setter  -->
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ProgressBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="6" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <!--
                        原生 ProgressBar 没有 CornerRadius 属性，所以不能 TemplateBinding，
                        直接在内层元素上用 DynamicResource 取尺寸令牌。
                    -->
                    <local:ProgressBar
                        MinHeight="{TemplateBinding MinHeight}"
                        VerticalAlignment="{TemplateBinding VerticalAlignment}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Foreground="{TemplateBinding Foreground}"
                        IsIndeterminate="{TemplateBinding IsIndeterminate}"
                        IsTabStop="{TemplateBinding IsTabStop}"
                        Maximum="{TemplateBinding Maximum}"
                        Minimum="{TemplateBinding Minimum}"
                        Value="{TemplateBinding Value}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
