<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:LightUi.Controls">

    <!--  只是壳子：模板根是 LightUi 的 ProgressBar 自定义控件，属性经 TemplateBinding 透传；可视逻辑在 controls/ProgressBar/  -->
    <Style TargetType="ProgressBar">
        <!--  隔断 WPF 默认主题样式里其余的 setter  -->
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ProgressBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="6" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <!--  原生 ProgressBar 没有 CornerRadius 属性，不能 TemplateBinding，只能在内层元素上取令牌  -->
                    <local:ProgressBar
                        MinHeight="{TemplateBinding MinHeight}"
                        VerticalAlignment="{TemplateBinding VerticalAlignment}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Foreground="{TemplateBinding Foreground}"
                        IsIndeterminate="{TemplateBinding IsIndeterminate}"
                        IsTabStop="{TemplateBinding IsTabStop}"
                        Maximum="{TemplateBinding Maximum}"
                        Minimum="{TemplateBinding Minimum}"
                        Value="{TemplateBinding Value}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
