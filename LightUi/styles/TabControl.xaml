<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  模板只支持 TabStripPlacement=Top：其它方向 DockPanel.Dock="Top" 会渲染异常  -->
    <Style x:Key="DefaultTabControlStyle" TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="0" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Border
                        Margin="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{DynamicResource ContainerCornerRadius}"
                        SnapsToDevicePixels="True">

                        <DockPanel Margin="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <!--  WPF 必须有 TabPanel + IsItemsHost=True 才会渲染 TabItem  -->
                            <StackPanel
                                HorizontalAlignment="Left"
                                DockPanel.Dock="Top"
                                Orientation="Horizontal">
                                <Border
                                    Background="{DynamicResource ControlBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="{DynamicResource ControlBorderThickness}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    DockPanel.Dock="Top">
                                    <TabPanel
                                        x:Name="HeaderPanel"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        IsItemsHost="True" />
                                </Border>

                            </StackPanel>

                            <!--  内容区：WPF 必需 PART_SelectedContentHost + ContentSource="SelectedContent"  -->
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource DefaultTabControlStyle}" TargetType="{x:Type TabControl}" />

</ResourceDictionary>