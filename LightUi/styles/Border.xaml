<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ContainerStyle —— 标准卡片：Padding 16、自带底色、1px 描边、ContainerCornerRadius 圆角。
        不设 Margin：卡片之间隔多远是版面的事，库不替调用方决定。
    -->

    <Style x:Key="ContainerStyle" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource ContainerCornerRadius}" />
    </Style>

</ResourceDictionary>
