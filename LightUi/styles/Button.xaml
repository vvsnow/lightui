<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:LightUi.Controls">

    <!--
        Button 系列的样式结构（命名参考 ModernWpf）：

          DefaultButtonStyle        —— 唯一的一份模板 + 默认外观
          <Style TargetType="Button">      —— 隐式的「默认按钮」，BasedOn 上面那份
          <Style TargetType="RepeatButton"> —— 同外观（RepeatButton 派生自 ButtonBase 而非 Button，
                                                 不能 BasedOn 一个 TargetType="Button" 的样式）
          AccentButtonStyle         —— 强调按钮，只换 brush，不复制模板
          SystemButtonStyle         —— 系统按钮（标题栏的最小化 / 最大化 / 关闭），46×32、直角
          CloseSystemButtonStyle    —— 关闭键专用：只把悬停 / 按下改成红底（Win11 观感）

        用法：<Button Style="{StaticResource AccentButtonStyle}" Content="Primary" />

        为什么强调变体可以不复制模板：
        模板里的 hover / pressed 触发器改成直接改「控件自己的 Background」（不写 TargetName），
        而 Style.Triggers 的优先级高于 Template 触发器，所以变体只要用自己的 Style.Triggers
        覆盖 Background，就能改掉悬停 / 按下色 —— 一份模板够用。
    -->
    <Style x:Key="DefaultButtonStyle" TargetType="ButtonBase">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Padding" Value="{DynamicResource ControlPaddingHorizontal}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ControlSelectedBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  隐式：默认按钮  -->
    <Style BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button" />

    <!--  隐式：RepeatButton 与默认按钮同外观  -->
    <Style BasedOn="{StaticResource DefaultButtonStyle}" TargetType="RepeatButton" />

    <!--
        强调按钮（Primary / Accent）：accent 底色 + 与底色对得上的前景色。
        只覆盖 brush 和 hover / pressed 色，模板复用 DefaultButtonStyle 那一份。
    -->
    <Style
        x:Key="AccentButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        系统按钮：标题栏右上角的最小化 / 最大化 / 关闭（也适用于自绘标题栏里的任何角落按钮）。
        常态完全透明 —— 只靠悬停 / 按下的背景色反馈，和 Windows 自己的标题栏按钮一致。

        用法：<Button Style="{StaticResource SystemButtonStyle}"
                      Command="{x:Static SystemCommands.CloseWindowCommand}">
                  <ui:FontIcon Glyph="&#xE8BB;" />
              </Button>

        为什么这一份要自带模板，而不像 AccentButtonStyle 那样只覆盖 brush：
        DefaultButtonStyle 的模板把 Border.CornerRadius 写成了 {DynamicResource ControlCornerRadius}，
        是模板内部的资源查找，不是 TemplateBinding —— Style 的 Setter 改不到它。想做到「直角」，
        要么改那份共享模板（会影响所有按钮），要么这里自带一份。选了后者：
        模板里直接用没有圆角的 Grid 代替 Border，顺便也去掉了边框。

        注意 MinHeight 必须显式归零：基类把它设成了 {DynamicResource ControlHeight}（当前 28），
        将来如果主题把 ControlHeight 调到比 32 大，MinHeight 会反过来把 Height 顶掉、按钮变高。
    -->
    <Style
        x:Key="SystemButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <!--  系统按钮46宽  -->
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="{x:Static local:WindowHelper.CaptionHeight}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <!--  标题栏按钮用标准箭头光标，不是 DefaultButtonStyle 的手型  -->
        <Setter Property="Cursor" Value="Arrow" />
        <!--  标题栏按钮不该抢焦点 / 进 Tab 顺序（否则 Alt+Tab、Tab 键会停在上面）  -->
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <!--  没有它，WindowChrome 会在 WM_NCHITTEST 里把这块判成标题栏，按钮点不动  -->
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--  不写 TargetName：改的是控件自己的 Background，Style.Triggers 才能盖掉它（同 DefaultButtonStyle）  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ControlSelectedBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        关闭键专用：悬停 / 按下改成红底白字（Windows 11 那颗 #C42B1C）。
        
        只覆盖 brush、不复制模板 —— 这正是本文件开头说的那套机制：
        SystemButtonStyle 的模板把 hover / pressed 写成「改控件自己的 Background」（不写 TargetName），
        而 Style.Triggers 的优先级高于 Template 触发器，所以这里写两个 Trigger 就能盖掉它。
        和 AccentButtonStyle 是同一个套路。
        
        Foreground 也要在这里改：红底上留深色 ✕ 会糊。
        但**光设 Button 的 Foreground 没用** —— FontIcon 自己的样式里就写了 Foreground（TextPrimaryBrush），
        元素自身的样式 Setter 会挡住从父级继承下来的值。所以模板里那颗 FontIcon 额外绑了一次
        「跟着按钮的 Foreground 走」，见 styles/Window.xaml 的 PART_CloseButton。
    -->
    <Style
        x:Key="CloseSystemButtonStyle"
        BasedOn="{StaticResource SystemButtonStyle}"
        TargetType="Button">
        <!--  关闭按钮比最小化 / 最大化宽 6px。  -->
        <Setter Property="Width" Value="52" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SystemCloseHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SystemCloseForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource SystemClosePressedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SystemCloseForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
