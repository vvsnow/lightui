<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Expander 默认样式（Win11 风味）：
        - 卡片化外观：圆角 6（ContainerCornerRadius）+ 1px 边框（BorderBrush）+ 底色（ControlBackgroundBrush）
        - 折叠态：只显示一行高 ExpanderHeaderHeight（默认 60）的头部
        - 展开态：头部 + 1px 分隔线 + body；body 用 ControlBackgroundSubtleBrush（略浅一档）
        - 头部用 chrome-less ToggleButton（模板内联重写）实现点击 + 键盘可访问
        IsChecked 与 Expander.IsExpanded 双向绑定
        - 箭头：复用 DropDownButton / ComboBox 已有的 ChevronDown Path（Data="M0,3 L5,7 L10,3"），
        通过 RotateTransform 在展开时翻 180°
        - 模板只支持 ExpandDirection=Down（与 Win11 一致；其它方向会渲染异常 —— 模板是 2 行 Grid）
        - 禁用：Opacity=0.45（项目惯例）
    -->

    <Style x:Key="DefaultExpanderStyle" TargetType="Expander">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
        <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
        <Setter Property="Padding" Value="{DynamicResource ControlPaddingHorizontal}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">

                    <Border
                        x:Name="OuterBd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{DynamicResource ContainerCornerRadius}"
                        SnapsToDevicePixels="True">

                        <Grid>
                            <Grid.RowDefinitions>
                                <!--  头部：ExpanderHeaderHeight（默认 60）  -->
                                <RowDefinition Height="Auto" />
                                <!--  分隔线行：折叠态 0，展开态 1  -->
                                <RowDefinition x:Name="SeparatorRow" Height="0" />
                                <!--  body 行：折叠态 0，展开态 Auto  -->
                                <RowDefinition x:Name="BodyRow" Height="0" />
                            </Grid.RowDefinitions>

                            <!--
                                头部：chrome-less ToggleButton（模板内联重写）。
                                IsChecked ↔ Expander.IsExpanded 双向绑定 → 点击 / Space / Enter 都能切。
                                模板内是相对独立的 namescope，所以 ChevronRotate 用 IsChecked 触发器来翻。
                            -->
                            <ToggleButton
                                x:Name="HeaderToggle"
                                Grid.Row="0"
                                Height="{DynamicResource ExpanderHeaderHeight}"
                                MinHeight="0"
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                SnapsToDevicePixels="True">

                                <!--
                                    ToggleButton 内容 = 头部 ContentPresenter。
                                    这里的 TemplateBinding 在 Expander 模板作用域里，
                                    绑定到 Expander.Header / HeaderTemplate / HeaderStringFormat。
                                    下方自定义模板里的 ContentPresenter (TemplateBinding Content)
                                    会把 ToggleButton.Content 渲染出来，Header 就显示了。
                                -->
                                <ContentPresenter
                                    Content="{TemplateBinding Header}"
                                    ContentStringFormat="{TemplateBinding HeaderStringFormat}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}"
                                    ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                                    RecognizesAccessKey="True" />

                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border
                                            x:Name="HeaderBd"
                                            Background="{TemplateBinding Background}"
                                            SnapsToDevicePixels="True">
                                            <Grid Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <ContentPresenter
                                                    Grid.Column="0"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center"
                                                    Content="{TemplateBinding Content}"
                                                    ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                    RecognizesAccessKey="True" />

                                                <!--
                                                    箭头：复用 DropDownButton / ComboBox 同一份 Path 数据。
                                                    Angle 由 IsChecked 触发器切到 180。
                                                -->
                                                <Path
                                                    x:Name="Chevron"
                                                    Grid.Column="1"
                                                    Width="10"
                                                    Height="10"
                                                    Margin="8,0,8,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Data="M0,3 L5,7 L10,3"
                                                    RenderTransformOrigin="0.5,0.5"
                                                    Stretch="Uniform"
                                                    Stroke="{TemplateBinding Foreground}"
                                                    StrokeEndLineCap="Round"
                                                    StrokeLineJoin="Round"
                                                    StrokeStartLineCap="Round"
                                                    StrokeThickness="1.2">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="0" />
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Grid>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderBd" Property="Background" Value="{DynamicResource ControlBackgroundHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="HeaderBd" Property="Background" Value="{DynamicResource ControlBackgroundSelectedBrush}" />
                                            </Trigger>
                                            <!--  展开态：箭头翻 180°（直接替换 Path 自己的 RenderTransform）  -->
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="180" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!--  1px 分隔线（折叠态 Height=0 不可见）  -->
                            <Border
                                x:Name="Separator"
                                Grid.Row="1"
                                Background="{DynamicResource BorderBrush}" />

                            <!--  body：略浅一档底色 ControlBackgroundSubtleBrush  -->
                            <Border
                                x:Name="BodyBd"
                                Grid.Row="2"
                                Padding="12,12"
                                CornerRadius="0,0,6,6"
                                Background="{DynamicResource ControlBackgroundSubtleBrush}">
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                            </Border>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!--  展开态：行高切换  -->
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="SeparatorRow" Property="Height" Value="1" />
                            <Setter TargetName="BodyRow" Property="Height" Value="Auto" />
                        </Trigger>
                        <!--
                            SourceName="HeaderToggle"：让 hover 触发器看 HeaderToggle（头部那个 ToggleButton）的 IsMouseOver，
                            而不是 Expander 自己的 IsMouseOver。
                            Expander.IsMouseOver 在 body 区域时也会被算 True（body 是 Expander 的视觉后代），
                            改成只看 HeaderToggle 的视觉 IsMouseOver，就只对头部区生效。
                            （同理 TabItem 那次 SourceName="Bd" 的修复）
                        -->
                        <Trigger SourceName="HeaderToggle" Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterBd" Property="Background" Value="{DynamicResource ControlBackgroundHoverBrush}" />
                        </Trigger>
                        <!--  禁用  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  隐式：所有 Expander 都用这套  -->
    <Style BasedOn="{StaticResource DefaultExpanderStyle}" TargetType="{x:Type Expander}" />

</ResourceDictionary>