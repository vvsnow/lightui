<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:LightUi.Controls">

    <!--
        ProgressBar（自定义控件）默认样式（参考 ModernWpf 的简化版）。
        用户平时写的是原生 <ProgressBar />，由 styles/ProgressBar.xaml 把它套进本控件；
        本文件才是真正的可视逻辑。

        这里只搭静态视觉树，动画全部在 ProgressBar.cs 里用 BeginAnimation 驱动 ——
        因为位移量依赖 ActualWidth（宽度自适应），放在 XAML 关键帧的 Value 绑定上实测不生效。
        指示块的显隐靠「宽度归零」而不是 Opacity，所以模板里没有任何视觉状态。
    -->

    <Style TargetType="{x:Type local:ProgressBar}">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource ProgressBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="MinHeight" Value="6" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ProgressBar}">
                    <Grid SnapsToDevicePixels="True">

                        <!--  轨道  -->
                        <Border
                            x:Name="ProgressBarRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">

                            <!--  裁剪宿主：Clip 由代码按实际尺寸 + 圆角写入，挡住滑出轨道的部分  -->
                            <Grid x:Name="TrackClip">

                                <!--  确定态指示块：宽度由代码写，HorizontalAlignment=Left 从左侧生长  -->
                                <Border
                                    x:Name="DeterminateProgressBarIndicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                    <Border.RenderTransform>
                                        <TranslateTransform />
                                    </Border.RenderTransform>
                                </Border>

                                <!--  不确定态指示块 1（40% 宽）  -->
                                <Border
                                    x:Name="IndeterminateProgressBarIndicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                    <Border.RenderTransform>
                                        <TranslateTransform />
                                    </Border.RenderTransform>
                                </Border>

                                <!--  不确定态指示块 2（60% 宽）  -->
                                <Border
                                    x:Name="IndeterminateProgressBarIndicator2"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                    <Border.RenderTransform>
                                        <TranslateTransform />
                                    </Border.RenderTransform>
                                </Border>

                            </Grid>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
