<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:LightUi.Controls">

    <!--
        图标字体随程序集打包（csproj 里以 Resource 进 dll），pack URI 直接引用，不依赖系统装没装 Segoe Fluent Icons。
        · # 后面必须是字体文件内部的家族名（"Segoe Fluent Icons"），且 # 前后不能有空格，否则会被当成系统字体名去找
        · 必须带程序集名（/LightUi;component/…）：外部程序集消费样式时，"/Assets/…" 会按宿主的根解析、找不到文件
    -->
    <Style TargetType="{x:Type local:FontIcon}">
        <Setter Property="FontFamily" Value="pack://application:,,,/LightUi;component/Assets/Fonts/SegoeIcons.TTF#Segoe Fluent Icons" />
        <Setter Property="FontSize" Value="{DynamicResource ControlGlyphFontSize}" />
        <!--  不设 Foreground：前景色跟随父级；写了具体 brush 就成了 local value，会盖掉继承（TabItem 选中态传不下来）  -->
        <Setter Property="Text" Value="{Binding Glyph, RelativeSource={RelativeSource Self}}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>